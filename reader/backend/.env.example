# ---- Required ----
MONGO_URI=mongodb://localhost:27017/reader
# Use a long random string (at least 32 characters in production), e.g. `openssl rand -hex 32`
JWT_SECRET=change-me-to-a-long-random-string

# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API (leave empty in local dev)
CORS_ORIGIN=
# Number of reverse proxies in front of the app (e.g. 1 behind Nginx/Render/Heroku)
TRUST_PROXY=0
# Serve the built frontend from this server (single-service deploy), e.g. ../frontend/dist
FRONTEND_DIST=
# Set to true only when the site is served over plain HTTP (no TLS); disables HSTS and upgrade-insecure-requests
ALLOW_HTTP=false
JWT_EXPIRES_IN=30d
# Log every request (method, path, status, size, time) to stdout
LOG_REQUESTS=false

# ---- Sign in with Google (optional) ----
# OAuth client ID of type "Web application" from Google Cloud Console > APIs & Services > Credentials.
# The Android app also needs an "Android" client (package name + SHA-1) in the same project.
GOOGLE_CLIENT_ID=

# ---- AI (optional; AI features are disabled without a key) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# AI requests allowed per user per hour (chat + recommendations + summaries)
AI_HOURLY_LIMIT=30

# ---- Book data ----
# Optional: improves descriptions and coverage of recent bestsellers.
# Free key: https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=
# Open Library asks clients to identify themselves with an app name and contact
OPEN_LIBRARY_USER_AGENT=ReaderApp/1.0 (you@example.com)
BOOK_API_TIMEOUT_MS=8000
# Where proxied cover images are cached (use a persistent volume in production)
COVER_CACHE_DIR=
# Set to true to skip the background catalog/cover warm-up (e.g. in tests)
DISABLE_WARMUP=false
